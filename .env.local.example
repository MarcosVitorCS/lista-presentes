# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase (Dashboard > Project Settings > API). .env.local nunca é commitado
# (já está no .gitignore) — só este .example é versionado, como template.

# Seguros para o navegador (chave "anon"/"publishable" — nunca a service_role).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Servidor apenas — usado por lib/dal/guest-session.ts para assinar o cookie de
# identificação do convidado (não é fonte de autorização, só UX). Gere com:
#   openssl rand -base64 32
GUEST_SESSION_SECRET=coloque-um-segredo-aleatorio-aqui

# NUNCA adicionar aqui: SUPABASE_SERVICE_ROLE_KEY. Este projeto não usa
# service_role no fluxo normal da aplicação (ver AGENTS.md / decisões de
# arquitetura). Só introduzir se houver necessidade técnica real e documentada.

# URL pública canônica do site — só para metadata (Open Graph, Twitter Card,
# canonical), sitemap.ts e robots.ts. Nunca usada para montar o link de
# convite (isso continua via window.location.origin, de propósito — ver
# InvitationsManager.tsx). Em produção, configurar o mesmo valor nas
# variáveis de ambiente do projeto na Vercel.
NEXT_PUBLIC_SITE_URL=https://www.listaae.com.br

# Servidor apenas — usado por app/actions/contact.ts para enviar o e-mail do
# formulário de interesse comercial da home (Resend: https://resend.com).
# IMPORTANTE: crie a conta Resend usando listaae.eventos@gmail.com como
# e-mail da conta. Sem verificar um domínio próprio, o remetente padrão
# (onboarding@resend.dev) só entrega para o próprio e-mail da conta — é
# assim que o formulário consegue mandar pra listaae.eventos@gmail.com sem
# precisar mexer em DNS de novo. Gere a chave em resend.com/api-keys.
RESEND_API_KEY=coloque-a-api-key-do-resend-aqui
