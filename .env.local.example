# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase (Dashboard > Project Settings > API). .env.local nunca é commitado
# (já está no .gitignore) — só este .example é versionado, como template.

# Seguros para o navegador (chave "anon"/"publishable" — nunca a service_role).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Servidor apenas — usado por lib/dal/guest-session.ts para assinar o cookie de
# identificação do convidado (não é fonte de autorização, só UX). Gere com:
#   openssl rand -base64 32
GUEST_SESSION_SECRET=coloque-um-segredo-aleatorio-aqui

# NUNCA adicionar aqui: SUPABASE_SERVICE_ROLE_KEY. Este projeto não usa
# service_role no fluxo normal da aplicação (ver AGENTS.md / decisões de
# arquitetura). Só introduzir se houver necessidade técnica real e documentada.
